---
import { Tabs, TabItem, Code } from '@astrojs/starlight/components';
---

<div id="install-tabs-wrapper">
  <Tabs>
    <TabItem label="Windows (PowerShell)">
      <Code code="iwr -useb https://boiler.iamabhinav.dev/install | iex" lang="powershell" />
    </TabItem>
    <TabItem label="Linux / macOS">
      <Code code="curl -fsSL https://boiler.iamabhinav.dev/install | sh" lang="sh" />
    </TabItem>
    <TabItem label="npm">
      <Code code="npm install -g @boilercli/core" lang="sh" />
    </TabItem>
  </Tabs>
</div>

<script>
  function autoSelectTab() {
    const wrapper = document.getElementById('install-tabs-wrapper');
    if (!wrapper) return;
    const isWindows = navigator.userAgent.includes('Windows');
    const tabs = wrapper.querySelectorAll('[role="tab"]');
    if (!isWindows && tabs[1]) (tabs[1] as HTMLElement).click();
  }
  autoSelectTab();
  document.addEventListener('astro:after-swap', autoSelectTab);
</script>
